+        let at_end = position == self.text_length();
+        let Some(bounds) = self.char_bounds(position.saturating_sub(usize::from(at_end))) else {
+            return;
+        };
+        let field = self.0.bounds.get();
+        let x = if at_end { bounds.x_max } else { bounds.x_min };
+        let x = (x - field.x_min - Self::GUTTER).to_pixels();
+        let width = (field.width() - Self::GUTTER * 2)
+            .max(Twips::ZERO)
+            .to_pixels();
+        let scroll = self.hscroll();
+        // Keep the insertion point inside the pixel-based scrollH viewport: https://airsdk.dev/reference/actionscript/3.0/flash/text/TextField.html#scrollH
+        let scroll = if x < scroll {
+            x.floor()
+        } else if x >= scroll + width {
+            (x - width + 1.0).ceil()
+        } else {
+            return;
+        };
+        self.set_hscroll(scroll.clamp(0.0, self.maxhscroll()));
