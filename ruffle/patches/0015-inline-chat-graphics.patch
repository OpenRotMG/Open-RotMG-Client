 pub fn init<'gc>(
     activation: &mut Activation<'_, 'gc>,
     this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    *element(this).element_data_mut(activation.gc()) = ElementData::Graphic {
+        graphic: args
+            .try_get_object(0)
+            .map(|o| o.as_display_object().unwrap()),
+        width: args.get_f64(1),
+        height: args.get_f64(2),
+        line: None,
+    };
+    Ok(Value::Undefined)
+}
+
+pub fn get_graphic<'gc>(
+    _activation: &mut Activation<'_, 'gc>,
+    this: Value<'gc>,
     _args: FunctionArgs<'_, 'gc>,
 ) -> Result<Value<'gc>, Error<'gc>> {
-    let this = this
-        .as_object()
-        .unwrap()
-        .as_content_element_object()
-        .unwrap();
+    let this = element(this);
+    let ElementData::Graphic { graphic, .. } = &*this.element_data() else {
+        unreachable!()
+    };
+    Ok(graphic
+        .map(|g| g.object2().unwrap().into())
+        .unwrap_or(Value::Null))
+}
+
+pub fn set_graphic<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let this = element(this);
+    let replacement = args
+        .try_get_object(0)
+        .map(|o| o.as_display_object().unwrap());
+    let (previous, binding) = {
+        let mut data = this.element_data_mut(activation.gc());
+        let ElementData::Graphic { graphic, line, .. } = &mut *data else {
+            unreachable!()
+        };
+        (std::mem::replace(graphic, replacement), *line)
+    };
+    if DisplayObject::option_ptr_eq(previous, replacement) {
+        return Ok(Value::Undefined);
+    }
+    if let Some((mut line, x, y)) = binding {
+        if let Some(previous) = previous.filter(|g| {
+            g.parent()
+                .is_some_and(|p| DisplayObject::ptr_eq(p, line.into()))
+        }) {
+            line.remove_child(activation.context, previous);
+        }
+        if let Some(graphic) = replacement {
+            graphic.set_x(Twips::from_pixels(x));
+            graphic.set_y(Twips::from_pixels(y));
+            line.insert_at_index(activation.context, graphic, line.num_children());
+        }
+    }
+    Ok(Value::Undefined)
+}
 
