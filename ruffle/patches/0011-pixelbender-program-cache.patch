+#[cfg(all(test, not(target_family = "wasm")))]
+mod program_cache_tests {
+    use super::*;
+    use ruffle_render::pixel_bender::parse_shader;
+
+    const BYTECODE: &[u8] = include_bytes!(
+        "../../../tests/tests/swfs/avm2/openrotmg_pixelbender_program_cache/shader.pbj"
+    );
+
+    fn compile(descriptors: &Descriptors, bytecode: &[u8]) -> PixelBenderWgpuShader {
+        PixelBenderWgpuShader::new(descriptors, parse_shader(bytecode, true).unwrap(), bytecode)
+    }
+
+    #[test]
+    fn exact_bytes_and_bounded_retention() {
+        let mut cache = PixelBenderProgramCache::default();
+        let zero = cache.slot(&0.0_f32.to_bits().to_le_bytes());
+        assert!(Arc::ptr_eq(
+            &zero,
+            &cache.slot(&0.0_f32.to_bits().to_le_bytes())
+        ));
+        assert!(!Arc::ptr_eq(
+            &zero,
+            &cache.slot(&(-0.0_f32).to_bits().to_le_bytes())
+        ));
+        let nan = f32::NAN.to_bits().to_le_bytes();
+        let first = cache.slot(&nan);
+        assert!(Arc::ptr_eq(&first, &cache.slot(&nan)));
+        assert!(!Arc::ptr_eq(
+            &first,
+            &cache.slot(&(f32::NAN.to_bits() + 1).to_le_bytes())
+        ));
+        assert_eq!(cache.programs.len(), 2);
+        assert_eq!((cache.hits, cache.misses, cache.evictions), (2, 4, 2));
+        assert!(!Arc::ptr_eq(
+            &zero,
+            &cache.slot(&0.0_f32.to_bits().to_le_bytes())
+        ));
+    }
+
+    #[test]
+    fn programs_share_but_instance_state_and_device_variants_do_not() {
+        fn assert_send_sync<T: Send + Sync>() {}
+        assert_send_sync::<Descriptors>();
+        assert_send_sync::<PixelBenderProgram>();
+        let backend = WgpuRenderBackend::for_offscreen(
+            (1, 1),
+            wgpu::Backends::VULKAN,
+            wgpu::PowerPreference::LowPower,
+        )
+        .expect("PixelBender cache test requires the headless Vulkan renderer");
+        let descriptors = backend.descriptors();
+        let a = compile(descriptors, BYTECODE);
+        let b = compile(descriptors, BYTECODE);
+        assert!(Arc::ptr_eq(&a.program, &b.program));
+        assert!(!std::ptr::eq(&a.shader, &b.shader));
+        assert_ne!(a.float_parameters_buffer, b.float_parameters_buffer);
+        assert_ne!(a.int_parameters_buffer, b.int_parameters_buffer);
+        assert_ne!(a.zeroed_out_of_range_mode, b.zeroed_out_of_range_mode);
+        assert!(!std::ptr::eq(&a.staging_belt, &b.staging_belt));
+        let pipeline = a
+            .program
+            .get_pipeline(descriptors, 1, TextureFormat::Rgba8Unorm);
+        assert_eq!(
+            pipeline,
+            b.program
+                .get_pipeline(descriptors, 1, TextureFormat::Rgba8Unorm)
+        );
+        assert_ne!(
+            pipeline,
+            a.program
+                .get_pipeline(descriptors, 4, TextureFormat::Rgba8Unorm)
+        );
+        assert_ne!(
+            pipeline,
+            a.program
+                .get_pipeline(descriptors, 1, TextureFormat::Bgra8Unorm)
+        );
+        assert_eq!(a.program.pipelines.lock().unwrap().len(), 3);
+        let weak = Arc::downgrade(&a.program);
+        drop(b);
+        drop(a);
+        assert!(
+            weak.upgrade().is_some(),
+            "cache must survive ShaderData disposal"
+        );
+        let a = compile(descriptors, BYTECODE);
+        let mut other = BYTECODE.to_vec();
+        other[8] = b'B';
+        let b = compile(descriptors, &other);
+        other[8] = b'D';
+        let c = compile(descriptors, &other);
+        assert!(!Arc::ptr_eq(&b.program, &c.program));
+        assert!(!Arc::ptr_eq(&a.program, &c.program));
+        assert_eq!(
+            pipeline,
+            a.program
+                .get_pipeline(descriptors, 1, TextureFormat::Rgba8Unorm)
+        );
+        let recompiled = compile(descriptors, BYTECODE);
+        assert!(
+            !Arc::ptr_eq(&a.program, &recompiled.program),
+            "eviction only loses reuse"
+        );
+        assert_eq!(
+            descriptors
+                .pixel_bender_programs
+                .lock()
+                .unwrap()
+                .programs
+                .len(),
