+        .expect("PixelBender cache test requires a second device");
+        let other_device = compile(second.descriptors(), BYTECODE);
+        assert!(!Arc::ptr_eq(&recompiled.program, &other_device.program));
+        assert_ne!(
+            recompiled
+                .program
+                .get_pipeline(descriptors, 1, TextureFormat::Rgba8Unorm),
+            other_device
+                .program
+                .get_pipeline(second.descriptors(), 1, TextureFormat::Rgba8Unorm)
+        );
+    }
+}
