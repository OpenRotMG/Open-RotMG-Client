diff --git a/web/packages/core/test/advancement.ts b/web/packages/core/test/advancement.ts
new file mode 100644
index 0000000..c482151
--- /dev/null
+++ b/web/packages/core/test/advancement.ts
@@ -0,0 +1,507 @@
+import { strict as assert } from "node:assert";
+import { runInNewContext } from "node:vm";
+import {
+    Advancement,
+    type AdvancementHost,
+    createAdvancementWorker,
+} from "../src/internal/player/advancement.js";
+
+class Wakeup {
+    onmessage: ((event: { data: unknown }) => void) | null = null;
+    onerror: ((event: { message: string }) => void) | null = null;
+    onmessageerror: (() => void) | null = null;
+    messages: { generation: number; delay?: number }[] = [];
+    terminated = false;
+    fail = false;
+    postMessage(message: { generation: number; delay?: number }) {
+        if (this.fail) {
+            throw new Error("post failed");
+        }
+        this.messages.push(message);
+    }
+    terminate() {
+        this.terminated = true;
+    }
+    fire(generation = this.messages.at(-1)!.generation) {
+        this.onmessage!({ data: generation });
+    }
+}
+
+function setup() {
+    const worker = new Wakeup();
+    let now = 100;
+    let next = 1;
+    const frames = new Map<number, () => void>();
+    const elapsed: number[] = [];
+    const events: string[] = [];
+    const host: AdvancementHost = {
+        now: () => now,
+        requestFrame: (callback) => {
+            const id = next++;
+            frames.set(id, callback);
+            return id;
+        },
+        cancelFrame: (id) => {
+            frames.delete(id);
+        },
+        playing: (value) => {
+            events.push(`playing:${value}`);
+        },
+        advance: (dt) => {
+            elapsed.push(dt);
+            events.push("advance");
+            return 10;
+        },
+        present: () => {
+            events.push("present");
+        },
+        destroy: () => {
+            events.push("destroy");
+        },
+    };
+    const owner = new Advancement(host, worker as unknown as Worker);
+    return {
+        owner,
+        worker,
+        host,
+        frames,
+        elapsed,
+        events,
+        time: (value: number) => {
+            now = value;
+        },
+        frame: () => {
+            const [id, callback] = frames.entries().next().value!;
+            frames.delete(id);
+            callback();
+        },
+    };
+}
+
+describe("Advancement production owner (controlled clock, non-native)", () => {
+    it("charges real window elapsed once, including delayed delivery, without RAF or bursts", () => {
+        const s = setup();
+        s.owner.play(true);
+        s.worker.fire();
+        s.time(125);
+        s.worker.fire();
+        s.time(6950);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 25, 6825]);
+        assert.equal(
+            s.worker.messages.filter((m) => m.delay !== undefined).length,
+            4,
+        );
+        assert.equal(s.frames.size, 1);
+        assert(!s.events.includes("present"));
+        s.frame();
+        s.frame();
+        assert.deepEqual(s.elapsed, [0, 25, 6825]);
+        assert.equal(s.frames.size, 1);
+    });
+
+    it("pause cancels stale tasks and resume resets baseline, not getTimer", () => {
+        const s = setup();
+        s.owner.play(true);
+        s.worker.fire();
+        const stale = s.worker.messages.at(-1)!.generation;
+        s.owner.play(false);
+        s.time(1200000);
+        s.worker.fire(stale);
+        assert.deepEqual(s.elapsed, [0]);
+        s.owner.play(true);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 0]);
+    });
+
+    it("hidden None preserves manual intent and explicit pause always wins", () => {
+        const s = setup();
+        s.owner.play(true);
+        s.worker.fire();
+        s.owner.policy(true, false);
+        s.owner.play(false);
+        s.owner.policy(false, false);
+        assert.equal(s.events.at(-1), "playing:false");
+        s.owner.policy(true, false);
+        s.owner.play(true);
+        assert.equal(s.events.at(-1), "playing:false");
+        s.owner.policy(false, false);
+        s.time(20000);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 0]);
+    });
+
+    it("explicit hidden pause survives showing in both background modes", () => {
+        for (const background of [false, true]) {
+            const s = setup();
+            s.owner.policy(false, background);
+            s.owner.play(true);
+            s.worker.fire();
+            s.owner.policy(true, background);
+            s.owner.play(false);
+            s.owner.policy(false, background);
+            s.time(20000);
+            s.worker.fire();
+            assert.deepEqual(s.elapsed, [0]);
+            assert.equal(s.events.at(-1), "playing:false");
+        }
+    });
+
+    it("direct focus/input boundaries alone do not change visibility policy or advancement time", () => {
+        const s = setup();
+        s.owner.play(true);
+        s.worker.fire();
+        const count = s.worker.messages.length;
+        s.owner.enterCoreCall();
+        s.owner.leaveCoreCall();
+        assert.equal(s.worker.messages.length, count);
+        s.time(125);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 25]);
+    });
+
+    it("MainThread and visibility changes retain a single clock and mode changes suspend", () => {
+        const s = setup();
+        s.owner.policy(false, true);
+        s.owner.play(true);
+        s.worker.fire();
+        s.owner.policy(true, true);
+        s.time(150);
+        s.worker.fire();
+        s.owner.policy(false, true);
+        s.time(175);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 50, 25]);
+        s.owner.policy(true, false);
+        s.owner.policy(true, true);
+        s.time(200);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 50, 25, 0]);
+    });
+
+    it("repeated public play reasserts core state/audio without creating another owner", () => {
+        const s = setup();
+        let corePlaying = false;
+        s.host.playing = (value) => {
+            corePlaying = value;
+        };
+        s.owner.play(true);
+        assert(corePlaying);
+        s.worker.fire();
+        // A real core can suspend itself after stepping without changing frontend intent.
+        corePlaying = false;
+        const pending = s.worker.messages.length;
+        s.owner.play(true);
+        assert(corePlaying);
+        assert.equal(s.worker.messages.length, pending);
+        s.time(125);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 25]);
+    });
+
+    it("repeated play/policy keeps one owner; RAF invokes presentation only", () => {
+        const s = setup();
+        s.owner.play(true);
+        const count = s.worker.messages.length;
+        s.owner.play(true);
+        s.owner.policy(false, false);
+        s.owner.policy(false, false);
+        assert.equal(s.worker.messages.length, count);
+        s.frame();
+        s.frame();
+        assert.equal(s.elapsed.length, 0);
+        s.worker.fire();
+        assert.equal(s.elapsed.length, 1);
+        assert.equal(s.events.filter((e) => e === "present").length, 2);
+    });
+
+    for (const operation of ["advance", "present"] as const) {
+        it(`defers synchronous ${operation} pause until the VM borrow returns`, () => {
+            const s = setup();
+            s.owner.play(true);
+            s.host[operation] = () => {
+                s.events.push("enter");
+                s.owner.play(false);
+                assert.notEqual(s.events.at(-1), "playing:false");
+                s.events.push("exit");
+                return 10;
+            };
+            if (operation === "advance") {
+                s.worker.fire();
+            } else {
+                s.frame();
+            }
+            assert.deepEqual(s.events.slice(-3), [
+                "enter",
+                "exit",
+                "playing:false",
+            ]);
+        });
+        it(`defers synchronous ${operation} destruction and rejects old reload callbacks`, () => {
+            const s = setup();
+            s.owner.play(true);
+            const staleFrame = s.frames.values().next().value!;
+            s.host[operation] = () => {
+                s.events.push("enter");
+                s.owner.destroy();
+                assert(!s.events.includes("destroy"));
+                s.events.push("exit");
+                return 10;
+            };
+            if (operation === "advance") {
+                s.worker.fire();
+            } else {
+                s.frame();
+            }
+            assert.deepEqual(s.events.slice(-3), ["enter", "exit", "destroy"]);
+            s.worker.fire();
+            staleFrame();
+            s.owner.destroy();
+            assert.equal(s.events.filter((e) => e === "destroy").length, 1);
+            assert.equal(s.frames.size, 0);
+            assert(s.worker.terminated);
+            const replacement = setup();
+            replacement.owner.play(true);
+            replacement.worker.fire();
+            assert.deepEqual(replacement.elapsed, [0]);
+        });
+    }
+
+    it("pause then play during a tick resets the next elapsed baseline", () => {
+        const s = setup();
+        s.owner.play(true);
+        s.host.advance = (dt) => {
+            s.elapsed.push(dt);
+            s.owner.play(false);
+            s.owner.play(true);
+            return 10;
+        };
+        s.worker.fire();
+        s.time(200);
+        s.worker.fire();
+        assert.deepEqual(s.elapsed, [0, 0]);
+    });
+
+    it("surfaces failed postMessage instead of switching to RAF advancement", () => {
+        const s = setup();
+        s.worker.fail = true;
+        assert.throws(() => s.owner.play(true), /post failed/);
+        assert.equal(s.elapsed.length, 0);
+    });
+
+    it("surfaces worker/decode/clock/deadline/owner/VM/frame-schedule errors and stops", () => {
+        for (const kind of [
+            "worker",
+            "decode",
+            "clock",
+            "deadline",
+            "owner",
+            "vm",
+            "frame",
+        ]) {
+            const s = setup();
+            s.owner.play(true);
+            if (kind === "clock") {
+                s.time(NaN);
+            }
+            if (kind === "deadline") {
+                s.host.advance = () => -1;
+            }
+            if (kind === "vm") {
+                s.host.advance = () => {
+                    throw new Error("core borrow failed");
+                };
+            }
+            if (kind === "frame") {
+                s.host.requestFrame = () => {
+                    throw new Error("RAF failed");
+                };
+            }
+            assert.throws(() => {
+                if (kind === "worker") {
+                    s.worker.onerror!({ message: "worker failed" });
+                } else if (kind === "decode") {
+                    s.worker.onmessageerror!();
+                } else if (kind === "owner") {
+                    s.worker.fire(999);
+                } else if (kind === "frame") {
+                    s.frame();
+                } else {
+                    s.worker.fire();
+                }
+            });
+            assert(s.worker.terminated, kind);
+            assert.equal(s.frames.size, 0, kind);
+        }
+    });
+
+    it("rejects a decreasing clock without charging negative elapsed", () => {
+        const s = setup();
+        s.owner.play(true);
+        s.worker.fire();
+        s.time(99);
+        assert.throws(() => s.worker.fire(), /monotonic/);
+        assert.deepEqual(s.elapsed, [0]);
+    });
+
+    for (const event of ["pointer", "keyboard", "text", "focus"]) {
+        it(`core-call boundary defers ${event} pause/destroy/reload until unlock`, () => {
+            for (const action of ["pause", "destroy", "reload"]) {
+                const s = setup();
+                s.owner.play(true);
+                s.owner.enterCoreCall();
+                s.events.push(event);
+                if (action === "pause") {
+                    s.owner.play(false);
+                } else {
+                    s.owner.destroy();
+                }
+                assert.equal(s.events.at(-1), event);
+                // The Rust boundary retains this owner token even if InnerPlayer clears/replaces it.
+                s.events.push("unlock");
+                s.owner.leaveCoreCall();
+                assert.deepEqual(s.events.slice(-2), [
+                    "unlock",
+                    action === "pause" ? "playing:false" : "destroy",
+                ]);
+                if (action === "reload") {
+                    const replacement = setup();
+                    replacement.owner.play(true);
+                    replacement.worker.fire();
+                    s.worker.fire();
+                    assert.deepEqual(replacement.elapsed, [0]);
+                }
+            }
+        });
+    }
+
+    it("cannot rearm after reentrant policy-application pause or destroy", () => {
+        for (const close of [false, true]) {
+            const s = setup();
+            s.host.playing = (active) => {
+                if (active) {
+                    s.owner.enterCoreCall();
+                    if (close) {
+                        s.owner.destroy();
+                    } else {
+                        s.owner.play(false);
+                    }
+                    s.owner.leaveCoreCall();
+                }
+            };
+            s.owner.play(true);
+            assert.equal(
+                s.worker.messages.filter((m) => m.delay !== undefined).length,
+                0,
+            );
+            assert.equal(s.worker.terminated, close);
+        }
+    });
+
+    it("surfaces cancellation failure but still releases the instance", () => {
+        const s = setup();
+        s.owner.play(true);
+        s.host.cancelFrame = () => {
+            throw new Error("cancel failed");
+        };
+        assert.throws(() => s.owner.destroy(), /cancel failed/);
+        assert(s.worker.terminated);
+        assert.equal(s.events.at(-1), "destroy");
+    });
+
+    it("rejects duplicate completed wakeups/RAFs rather than treating them as cancellation", () => {
+        const s = setup();
+        s.owner.play(true);
+        const wake = s.worker.messages.at(-1)!.generation;
+        s.worker.fire(wake);
+        assert.throws(() => s.worker.fire(wake), /owner\/generation/);
+        const r = setup();
+        const frame = r.frames.values().next().value!;
+        r.frame();
+        assert.throws(frame, /presentation callback owner/);
+    });
+
+    it("rejects malformed wakeups, not mistaking unknown data for canceled tasks", () => {
+        for (const data of [0, -1, 0.5, NaN, "tick", {}]) {
+            const s = setup();
+            s.owner.play(true);
+            assert.throws(
+                () => s.worker.onmessage!({ data }),
+                /owner\/generation/,
+            );
+            assert(s.worker.terminated);
+        }
+    });
+
+    it("uses the actual worker source with one timeout and no worker clock", async () => {
+        const saved = {
+            worker: globalThis.Worker,
+            create: URL.createObjectURL,
+            revoke: URL.revokeObjectURL,
+        };
+        let blob: Blob | undefined;
+        URL.createObjectURL = (value) => {
+            assert(value instanceof Blob);
+            blob = value;
+            return "blob:test";
+        };
+        URL.revokeObjectURL = () => {};
+        globalThis.Worker = function () {
+            return {};
+        } as unknown as typeof Worker;
+        try {
+            createAdvancementWorker();
+            assert(blob);
+            let next = 0;
+            const timers = new Map<number, () => void>();
+            const messages: unknown[] = [];
+            const self = {
+                onmessage: (_event: { data: unknown }) => {},
+                postMessage: (value: unknown) => messages.push(value),
+            };
+            runInNewContext(await blob.text(), {
+                self,
+                clearTimeout: (id: number) => timers.delete(id),
+                setTimeout: (callback: () => void) => {
+                    timers.set(++next, callback);
+                    return next;
+                },
+            });
+            self.onmessage({ data: { generation: 1, delay: 10 } });
+            self.onmessage({ data: { generation: 2, delay: 20 } });
+            assert.equal(timers.size, 1);
+            const [id, callback] = timers.entries().next().value!;
+            timers.delete(id);
+            callback();
+            assert.deepEqual(messages, [2]);
+            assert.equal(timers.size, 0);
+            self.onmessage({ data: { generation: 3, delay: 10 } });
+            self.onmessage({ data: { generation: 4 } });
+            assert.equal(timers.size, 0);
+        } finally {
+            globalThis.Worker = saved.worker;
+            URL.createObjectURL = saved.create;
+            URL.revokeObjectURL = saved.revoke;
+        }
+    });
+
+    it("worker construction failure is explicit and revokes its URL", () => {
+        const oldWorker = globalThis.Worker;
+        const oldRevoke = URL.revokeObjectURL;
+        let revoked = false;
+        globalThis.Worker = function () {
+            throw new Error("CSP worker denied");
+        } as unknown as typeof Worker;
+        URL.revokeObjectURL = (url) => {
+            revoked = true;
+            oldRevoke(url);
+        };
+        try {
+            assert.throws(createAdvancementWorker, /CSP worker denied/);
+            assert(revoked);
+        } finally {
+            globalThis.Worker = oldWorker;
+            URL.revokeObjectURL = oldRevoke;
+        }
+    });
+});
