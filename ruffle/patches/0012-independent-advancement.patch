index 0000000..77d36bc
--- /dev/null
+++ b/web/packages/core/src/internal/player/advancement.ts
@@ -0,0 +1,258 @@
+export interface AdvancementHost {
+    now(): number;
+    requestFrame(callback: () => void): number;
+    cancelFrame(id: number): void;
+    playing(value: boolean): void;
+    advance(elapsed: number): number;
+    present(): void;
+    destroy(): void;
+}
+
+/**
+ * Keeps wakeup delivery independent of RAF, without moving the VM off the window.
+ *
+ * @returns The single wakeup producer, never a VM or clock owner.
+ */
+export function createAdvancementWorker(): Worker {
+    const url = URL.createObjectURL(
+        new Blob(
+            [
+                `
+        let timer;
+        self.onmessage = ({data}) => {
+            clearTimeout(timer);
+            if (data.delay !== undefined) {
+                timer = setTimeout(() => self.postMessage(data.generation), data.delay);
+            }
+        };
+    `,
+            ],
+            { type: "application/javascript" },
+        ),
+    );
+    try {
+        return new Worker(url);
+    } finally {
+        URL.revokeObjectURL(url);
+    }
+}
+
+export class Advancement {
+    private intent = false;
+    private playRequested = false;
+    private active = false;
+    private hidden = false;
+    private background = false;
+    private closed = false;
+    private cleaned = false;
+    private busy = false;
+    private coreDepth = 0;
+    private generation = 0;
+    private cancelledThrough = 0;
+    private pending = false;
+    private frame: number | null = null;
+    private last: number | null = null;
+    private delay = 0;
+
+    constructor(
+        private host: AdvancementHost,
+        private worker: Worker,
+    ) {
+        worker.onmessage = ({ data }: MessageEvent<unknown>) => {
+            if (
+                this.closed ||
+                (typeof data === "number" &&
+                    Number.isSafeInteger(data) &&
+                    data > 0 &&
+                    data <= this.cancelledThrough)
+            ) {
+                return;
+            }
+            this.run(() => {
+                if (data !== this.generation || !this.pending || !this.active) {
+                    throw new Error(
+                        "Unexpected advancement wakeup owner/generation",
+                    );
+                }
+                this.pending = false;
+                const now = host.now();
+                if (
+                    !Number.isFinite(now) ||
+                    (this.last !== null && now < this.last)
+                ) {
+                    throw new Error(
+                        "Invalid window monotonic advancement clock",
+                    );
+                }
+                const elapsed = this.last === null ? 0 : now - this.last;
+                this.last = now;
+                this.delay = host.advance(elapsed);
+                if (!Number.isFinite(this.delay) || this.delay < 0) {
+                    throw new Error("Invalid core advancement deadline");
+                }
+            });
+        };
+        worker.onerror = (event) => {
+            this.destroy();
+            throw new Error(`Advancement worker failed: ${event.message}`);
+        };
+        worker.onmessageerror = () => {
+            this.destroy();
+            throw new Error("Advancement worker message could not be decoded");
+        };
+        this.run(() => host.playing(false));
+        this.requestFrame();
+    }
+
+    play(value: boolean): void {
+        if (this.closed) {
+            return;
+        }
+        try {
+            if (this.intent !== value) {
+                this.invalidate();
+            }
+            this.intent = value;
+            this.playRequested = value;
+            this.reconcile();
+        } catch (error) {
+            this.destroy();
+            throw error;
+        }
+    }
+
+    policy(hidden: boolean, background: boolean): void {
+        if (this.closed) {
+            return;
+        }
+        if (this.hidden !== hidden || this.background !== background) {
+            console.debug("Ruffle advancement policy", { hidden, background });
+        }
+        this.hidden = hidden;
+        this.background = background;
+        this.reconcile();
+    }
+
+    enterCoreCall(): void {
+        this.coreDepth++;
+    }
+
+    leaveCoreCall(): void {
+        if (this.coreDepth === 0) {
+            throw new Error("Unbalanced core call boundary");
+        }
+        this.coreDepth--;
+        this.reconcile();
+    }
+
+    destroy(): void {
+        if (this.closed) {
+            return;
+        }
+        this.closed = true;
+        this.generation++;
+        this.pending = false;
+        try {
+            this.worker.terminate();
+            if (this.frame !== null) {
+                this.host.cancelFrame(this.frame);
+            }
+        } finally {
+            this.frame = null;
+            this.reconcile();
+        }
+    }
+
+    private invalidate(): void {
+        this.cancelledThrough = ++this.generation;
+        this.pending = false;
+        this.last = null;
+        this.delay = 0;
+        this.worker.postMessage({ generation: this.generation });
+    }
+
+    private reconcile(): void {
+        // ExternalInterface can change intent while core holds its player lock.
+        if (this.busy || this.coreDepth > 0) {
+            return;
+        }
+        try {
+            if (this.closed) {
+                if (!this.cleaned) {
+                    this.cleaned = true;
+                    this.host.destroy();
+                }
+                return;
+            }
+            const active = this.intent && (!this.hidden || this.background);
+            const changed = active !== this.active;
+            if (changed || (active && this.playRequested)) {
+                this.playRequested = false;
+                if (changed) {
+                    this.invalidate();
+                    this.active = active;
+                    console.debug("Ruffle advancement lifecycle", {
+                        active,
+                        hidden: this.hidden,
+                        background: this.background,
+                    });
+                }
+                this.host.playing(active);
+            }
+            if (!this.closed && this.active && !this.pending) {
+                this.pending = true;
+                this.generation++;
+                this.worker.postMessage({
+                    generation: this.generation,
+                    delay: this.delay,
+                });
+            }
+        } catch (error) {
+            this.destroy();
+            throw error;
+        }
+    }
+
+    private run(callback: () => void): void {
+        if (this.busy || this.coreDepth > 0) {
+            throw new Error("Reentrant advancement/presentation owner");
+        }
+        this.busy = true;
+        try {
+            callback();
+        } catch (error) {
+            this.destroy();
+            throw error;
+        } finally {
+            this.busy = false;
+            this.reconcile();
+        }
+    }
+
+    private requestFrame(): void {
+        if (this.closed) {
+            return;
+        }
+        try {
+            if (this.frame !== null) {
+                throw new Error("Duplicate presentation owner");
+            }
+            const id = this.host.requestFrame(() => {
+                if (this.closed) {
+                    return;
+                }
+                if (this.frame !== id) {
+                    this.destroy();
+                    throw new Error("Unexpected presentation callback owner");
+                }
+                this.frame = null;
+                this.run(() => this.host.present());
+                this.requestFrame();
+            });
+            this.frame = id;
+        } catch (error) {
+            this.destroy();
+            throw error;
+        }
+    }
+}
